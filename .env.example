# ==========================================
# AURA MERN E-Commerce Environment Configuration
# ==========================================

# Port for the Node.js / Express Server
PORT=3000

# MongoDB Connection String (e.g. MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aura_ecommerce?retryWrites=true&w=majority
# Note: If left unset, the application automatically uses the persistent local document store (server/data/db.json)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mongodb.net/aura_store"

# Secret key for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET="aura_super_secure_jwt_secret_production_key"

# Node Environment
NODE_ENV="development"
